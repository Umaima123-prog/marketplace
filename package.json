{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --env-file-if-exists=.env scripts/prepare-test-db.mjs && node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "verify:shopify": "node --import tsx --env-file-if-exists=.env scripts/verify-shopify-auth.mts",
    "worker": "node --import tsx --env-file-if-exists=.env src/worker/index.ts",
    "worker:dev": "node --import tsx --watch --env-file-if-exists=.env src/worker/index.ts",
    "start:production": "node scripts/start-production.mjs"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/hono": "^9.10.2",
    "@bull-board/ui": "^9.10.2",
    "@hono/node-server": "^1.19.17",
    "@prisma/client": "6.19.3",
    "bootstrap": "^4.6.2",
    "bullmq": "^6.3.9",
    "hono": "^4.13.12",
    "ioredis": "^6.0.0",
    "next": "16.3.6",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "6.19.3",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
