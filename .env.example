# ===========================================================================
# Copy to .env and fill in. .env is gitignored; this file is committed.
#
#   cp .env.example .env
#
# Everything below is a PLACEHOLDER. Never commit real values.
# ===========================================================================

# ---------------------------------------------------------------------------
# Docker Compose — MySQL container bootstrap
#
# These are consumed by docker-compose.yml and by the one-time init script at
# docker/mysql/init/01-databases-and-grants.sh. They take effect only on FIRST
# container start (when the named volume is empty). Changing them afterwards
# requires `docker compose down -v`, which DESTROYS the local database.
# ---------------------------------------------------------------------------

# Root is used only by the container's own bootstrap and healthcheck.
# The application NEVER connects as root.
MYSQL_ROOT_PASSWORD=

# The dedicated application/development user. This is who Prisma connects as.
MYSQL_USER=marketplace_app
MYSQL_PASSWORD=

# Application database and the Prisma Migrate shadow database. Both are created
# by the init script with utf8mb4 / utf8mb4_unicode_ci.
MYSQL_DATABASE=marketplace
MYSQL_SHADOW_DATABASE=marketplace_shadow
# Read by docker/mysql/init/01-databases-and-grants.sh, not by MySQL itself: the
# integration suite's database, created and granted on first initialisation so a
# fresh clone can run `npm run test:integration` without a manual step. The name
# must end in `_test` -- the test harness refuses to run otherwise, because those
# tests TRUNCATE every table.
MYSQL_TEST_DATABASE=marketplace_test

# Host port mappings. 3306 is deliberately NOT the default: a locally installed
# MySQL service usually already owns it. Change only if 3307 is also taken.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# ---------------------------------------------------------------------------
# Prisma / application connections
#
# Use 127.0.0.1 rather than localhost: on Windows, "localhost" can resolve to
# ::1 and fail against a container published on IPv4 only.
#
# Host/port/db/user below MUST agree with the MYSQL_* values above.
# ---------------------------------------------------------------------------

# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=N
DATABASE_URL="mysql://marketplace_app:REPLACE_ME@127.0.0.1:3307/marketplace?connection_limit=10"

# Used ONLY by `prisma migrate dev`. Prisma wipes this database's contents on
# every run — it must never point at real data.
SHADOW_DATABASE_URL="mysql://marketplace_app:REPLACE_ME@127.0.0.1:3307/marketplace_shadow"

# Integration tests ONLY. Must name a database ending in `_test`:
# tests/integration/setup.ts refuses to run against anything else, because the
# suite truncates every table between test files. Create it once with:
#   docker exec marketplace-mysql mysql -uroot -p... -e #     "CREATE DATABASE marketplace_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#      GRANT ALL ON marketplace_test.* TO 'marketplace_app'@'%';"
TEST_DATABASE_URL="mysql://marketplace_app:REPLACE_ME@127.0.0.1:3307/marketplace_test?connection_limit=5"

# The worker should size connection_limit to its own concurrency, independently
# of the web process. Example for a worker running concurrency 10:
#   DATABASE_URL="mysql://marketplace_app:REPLACE_ME@127.0.0.1:3307/marketplace?connection_limit=15"

# ---------------------------------------------------------------------------
# Redis / BullMQ
# ---------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ---------------------------------------------------------------------------
# Shopify Admin API — custom app on a single development store.
# NEVER prefix any of these with NEXT_PUBLIC_: that would ship the token to the
# browser. These are server-only, in both the web and worker processes.
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com

# Pin explicitly. Shopify versions are quarterly and deprecate on a schedule.
SHOPIFY_API_VERSION=

# --- Authentication: client credentials grant (primary) --------------------
# The app exchanges these for a short-lived Admin API access token with no
# merchant interaction:
#
#   POST https://{shop}/admin/oauth/access_token
#   grant_type=client_credentials&client_id=...&client_secret=...
#   -> { access_token, scope, expires_in: 86399 }
#
# The token lasts 24 hours and is cached in memory for slightly less than that,
# then re-requested. It is never written to disk and never logged.
#
# The grant requests no scopes: the token receives whatever the app version
# declares in the Dev Dashboard, and a missing scope surfaces as a 403 on the
# call that needs it. The app and the store must belong to the same Shopify
# organization.
#
# REQUIRED ACCESS SCOPES (declared on the app version, not requested here):
#
#   read_products        catalog sync
#   read_inventory       inventoryQuantity / tracked, for the stock check
#   write_draft_orders   draftOrderCreate + draftOrderComplete
#   read_draft_orders    the submission's two recovery lookups --
#                        draftOrder(id:) before completing, and the
#                        draftOrders(query: 'tag:"cod-<key>"') pre-flight that
#                        finds a draft whose create response was lost
#
# read_draft_orders is REQUIRED by the worker, and in practice arrives for free:
# Shopify grants the implied read scope alongside write_draft_orders. Verified on
# the development store -- currentAppInstallation.accessScopes returns
# read_draft_orders, read_inventory, read_products, write_draft_orders, and both
# recovery lookups execute successfully. It is listed explicitly anyway, because
# "implied by another scope" is not something a reviewer should have to know, and
# an app version declaring only read-side scopes would break submission.
#
# PROTECTED CUSTOMER DATA. A cash-on-delivery order cannot be delivered without
# a name, a phone number and an address, so draftOrderCreate sends all four of
# Shopify's LEVEL 2 protected customer fields: name, email, phone, address.
# Level 2 is "always available" for a custom app and needs no review on a
# development store, but it must be enabled for the app: before this app was
# reinstalled through its Custom distribution link, Shopify refused to return the
# CalculatedDraftOrder object at all. After reinstalling, the full guest-COD
# input validates with zero userErrors. If a fresh install ever hits that refusal
# again, reinstall via the Custom distribution link -- do NOT strip the customer
# fields to get past it. An order with no address is not a deliverable order.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Authentication: permanent token (alternative) -------------------------
# Only for an admin-created custom app (Settings -> Apps -> Develop apps),
# which issues a pre-generated, non-expiring token. When set, it short-circuits
# the grant above. Leave empty when using client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Bonus scope only; core sync does not depend on webhooks.
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Worker timing. Both must exceed p99 job duration, or healthy in-flight work
# gets reclaimed mid-execution.
#
# Order submission has its own timings; see "Order submission" below.
# PENDING_SYNC_GRACE_SECONDS was planned here before the code existed and is NOT
# read by anything -- the implemented name is ORDER_RECOVERY_GRACE_SECONDS.
# ---------------------------------------------------------------------------
SYNC_HEARTBEAT_STALE_SECONDS=600
PRODUCT_SYNC_INTERVAL_MINUTES=15

# Shopify page sizes. Defaults are the production values (50 x 100); override
# only for a controlled run or when tuning from the requestedCost/availableCost
# figures on the page_complete log line.
# SHOPIFY_PRODUCTS_PER_PAGE=50
# SHOPIFY_VARIANTS_PER_PAGE=100

# Set false to start a worker that registers no repeatable jobs and processes
# only what is explicitly enqueued. Useful for a controlled run; leave unset in
# normal operation, where the 15-minute incremental sync IS the freshness
# guarantee.
# SYNC_SCHEDULERS_ENABLED=true

# ---------------------------------------------------------------------------
# Order submission (worker only)
# ---------------------------------------------------------------------------

# How long a worker's claim on an order is believed. A SYNCING order whose claim
# is older than this belonged to a worker that died and may be reclaimed. Must
# comfortably exceed a worst-case submission (two Shopify round trips plus
# retries), or a healthy slow job is reclaimed underneath itself.
# ORDER_CLAIM_LEASE_SECONDS=300

# How old a PENDING_SYNC order must be before the recovery sweep re-enqueues it.
# Long enough that an order whose enqueue is still in flight is never swept.
# ORDER_RECOVERY_GRACE_SECONDS=120

# How often the recovery sweep runs.
# ORDER_RECOVERY_INTERVAL_MINUTES=5

# How "unpaid, collect cash on delivery" is expressed to Shopify.
#
#   payment_pending (DEFAULT) - draftOrderComplete(paymentPending: true).
#       DEPRECATED on API 2026-07 but present, functional, and needs no extra
#       permission. This is what the verified live order used: the resulting
#       Shopify order came out PENDING with the full amount outstanding.
#
#   payment_terms             - payment terms on the draft; the NON-deprecated
#       path, and where this should end up. Currently refused for this app:
#       draftOrderCreate answers "The user must have access to set payment
#       terms." Note draftOrderCalculate ACCEPTS the same input, so validating
#       the input shape does not prove the permission exists.
#
# Migration: grant the app permission to set payment terms, then set this to
# payment_terms. See ARCHITECTURE 4.2c gap D10.
# SHOPIFY_COD_PAYMENT_MODE=payment_pending

# The recovery sweep has its OWN switch, separate from SYNC_SCHEDULERS_ENABLED:
# silencing scheduled catalog sync during a controlled run must not also stop
# orders being recovered. With this false, an order whose enqueue was lost waits
# for a human. There is no good reason to set it outside a test.
# ORDER_RECOVERY_ENABLED=true
